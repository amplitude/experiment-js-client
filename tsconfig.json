{
  "compilerOptions": {
    "lib": ["es2017", "dom"],
    "module": "es2020",
    "noEmitOnError": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "es2017",
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": "."
  }
}
