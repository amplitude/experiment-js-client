{
  "name": "@amplitude/experiment-tag",
  "version": "0.29.0",
  "description": "Amplitude Experiment Javascript Snippet",
  "author": "Amplitude",
  "homepage": "https://github.com/amplitude/experiment-js-client",
  "license": "MIT",
  "main": "dist/experiment-tag.umd.js",
  "types": "dist/types/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amplitude/experiment-js-client.git",
    "directory": "packages/experiment-tag"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c && node example/build_example.js",
    "build-dev": "rm -rf dist && NODE_ENV=development rollup -c && node example/build_example.js",
    "clean": "rimraf node_modules dist",
    "lint": "cd ../.. && eslint packages/experiment-tag --ignore-path .eslintignore && prettier -c packages/experiment-tag --ignore-path .prettierignore",
    "test": "jest",
    "prepublish": "yarn build"
  },
  "bugs": {
    "url": "https://github.com/amplitude/experiment-js-client/issues"
  },
  "dependencies": {
    "@amplitude/analytics-connector": "^1.6.7",
    "@amplitude/analytics-core": "^2.21.0",
    "@amplitude/analytics-types": "^2.11.0",
    "@amplitude/experiment-core": "^0.13.5",
    "@amplitude/experiment-js-client": "^1.23.0",
    "dom-mutator": "git+ssh://git@github.com/amplitude/dom-mutator#12c98baf791d3f5b803f6f30517512df6f1b0a2a",
    "rollup-plugin-license": "^3.6.0",
    "unfetch": "4.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "construct-style-sheets-polyfill": "^3.1.0",
    "rollup-plugin-gzip": "^3.1.0",
    "rollup-plugin-license": "^3.6.0"
  },
  "files": [
    "dist"
  ]
